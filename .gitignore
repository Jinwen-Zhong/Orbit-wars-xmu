```gitignore
# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Environment variables
.env

# Logs
*.log

# Large or temporary experiment outputs
results/raw/
*.tmp

# Model binary files
*.pkl
*.joblib

# Kaggle credentials
kaggle.json